[Unit]
Description=Algo Trading Executor
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/algo_trade
ExecStart=/home/ubuntu/algo_trade/venv_algotrade/bin/python main.py
EnvironmentFile=/home/ubuntu/algo_trade/.env
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
